# Puerto del servidor
PORT=3000
NODE_ENV=development

# Configuración SQLite (desarrollo local / corte de luz)
LOCAL_DB_PATH=./dev_local.db

# Configuración Turso (se llenará cuando creemos la BD online)
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Rol de la Computadora (CAJA_PRINCIPAL o SECUNDARIA)
APP_ROLE=CAJA_PRINCIPAL

# Autenticación y Seguridad
AUTH_ENABLED=true
JWT_SECRET=cambiar_este_valor_en_produccion

# Credenciales de Usuarios Semilla (Seed)
ADMIN_EMAIL=admin@nextbyte.com
ADMIN_PASSWORD=admin123
CONTINGENCIA_EMAIL=caja@nextbyte.com
CONTINGENCIA_PASSWORD=caja123
