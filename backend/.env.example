# Puerto del servidor
PORT=3000
NODE_ENV=development

# Modo de Base de Datos y Contingencia Offline
DB_MODE=cloud
CONTINGENCY_ENABLED=false
LOCAL_DB_PATH=./data/contingencia.db

# Configuración Turso (Cloud)
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Rol de la Computadora (CAJA_PRINCIPAL o SECUNDARIA)
APP_ROLE=CAJA_PRINCIPAL
WRITER_ID=

# Sondas de Internet independientes (opcional, separadas por coma)
INTERNET_PROBE_URLS=https://cloudflare.com/cdn-cgi/trace,https://connectivitycheck.gstatic.com/generate_204

# Autenticación y Seguridad
AUTH_ENABLED=true
JWT_SECRET=cambiar_este_valor_en_produccion

# Credenciales de Usuarios Semilla (Seed)
ADMIN_EMAIL=admin@nextbyte.com
ADMIN_PASSWORD=admin123
CONTINGENCIA_EMAIL=caja@nextbyte.com
CONTINGENCIA_PASSWORD=caja123
