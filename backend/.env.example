# Puerto del servidor
PORT=3000
NODE_ENV=development

# Configuración SQLite (Desarrollo local / Contingencia)
LOCAL_DB_PATH=./dev_local.db

# Configuración Turso (Se llenará cuando creen la BD)
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Rol de la Computadora (CAJA_PRINCIPAL o SECUNDARIA)
# En desarrollo puedes probar cambiando esto
APP_ROLE=CAJA_PRINCIPAL
